<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- The scratch payload template. Copied by c3d_project_init; also the Phase 2/3 test subject.
       Build with -c R2024 (or R2025/R2026). AssemblyName is stamped {RootNamespace}_r{N} by
       Directory.Build.props while the file on disk stays {RootNamespace}.dll. -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">R2024</Configuration>
    <OutputType>Library</OutputType>
    <RootNamespace>C3dPayload</RootNamespace>
    <AssemblyName>$(RootNamespace)_r$(PayloadRev)</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net48</TargetFramework>
    <Configurations>R2024;R2025;R2026</Configurations>
    <UseWPF>true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'R2024' ">
    <DefineConstants>DEBUG;R2024</DefineConstants><TargetFramework>net48</TargetFramework><Civil3dVersion>2024</Civil3dVersion><OutputPath>bin\R2024\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'R2025' ">
    <DefineConstants>DEBUG;R2025</DefineConstants><TargetFramework>net8.0-windows</TargetFramework><Civil3dVersion>2025</Civil3dVersion><OutputPath>bin\R2025\</OutputPath><UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'R2026' ">
    <DefineConstants>DEBUG;R2026</DefineConstants><TargetFramework>net8.0-windows</TargetFramework><Civil3dVersion>2026</Civil3dVersion><OutputPath>bin\R2026\</OutputPath><UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <Choose>
    <When Condition=" '$(Configuration)'=='R2024' "><ItemGroup>
      <PackageReference Include="Speckle.AutoCAD.API" Version="2024.0.0" IncludeAssets="build; compile" PrivateAssets="All" />
      <PackageReference Include="Speckle.Civil3D.API" Version="2024.0.0" IncludeAssets="build; compile" PrivateAssets="All" />
    </ItemGroup></When>
    <When Condition=" '$(Configuration)'=='R2025' "><ItemGroup>
      <PackageReference Include="Speckle.AutoCAD.API" Version="2025.0.0" IncludeAssets="build; compile" PrivateAssets="All" />
      <PackageReference Include="Speckle.Civil3D.API" Version="2025.0.0" IncludeAssets="build; compile" PrivateAssets="All" />
    </ItemGroup></When>
    <Otherwise><ItemGroup>
      <PackageReference Include="Speckle.AutoCAD.API" Version="2026.0.0" IncludeAssets="build; compile" PrivateAssets="All" />
      <PackageReference Include="Speckle.Civil3D.API" Version="2026.0.0" IncludeAssets="build; compile" PrivateAssets="All" />
    </ItemGroup></Otherwise>
  </Choose>
  <!-- Bridge assemblies: Private=false so they are NOT copied beside the payload; the host's
       resolver hands the payload the host's single loaded copy (type identity across reloads). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\C3dMCP.Sdk\C3dMCP.Sdk.csproj" Private="false" />
    <ProjectReference Include="..\..\src\C3dMCP.Engine\C3dMCP.Engine.csproj" Private="false" />
  </ItemGroup>
</Project>
